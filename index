<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sumit Sasalatti | Portfolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Syncopate:wght@700&family=Plus+Jakarta+Sans:wght@300;400;600&display=swap" rel="stylesheet">
    
    <style>
        /* --- Design Tokens & Resets --- */
        :root {
            --bg-color: #0a0a0a;
            --card-bg: #141414;
            --primary-red: #ff1e27;
            --accent-red: #990006;
            --text-main: #ffffff;
            --text-muted: #a0a0a0;
            --font-display: 'Syncopate', sans-serif;
            --font-body: 'Plus Jakarta Sans', sans-serif;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            cursor: none; /* Hide default cursor for custom animation */
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: var(--font-body);
            overflow-x: hidden;
        }

        /* --- Custom Mouse Animation Elements --- */
        .cursor-dot {
            width: 8px;
            height: 8px;
            background-color: var(--primary-red);
            position: fixed;
            pointer-events: none;
            z-index: 9999;
            border-radius: 50%;
            transform: translate(-50%, -50%);
            transition: width 0.2s, height 0.2s;
        }

        .cursor-outline {
            width: 40px;
            height: 40px;
            border: 2px solid rgba(255, 30, 39, 0.4);
            position: fixed;
            pointer-events: none;
            z-index: 9998;
            border-radius: 50%;
            transform: translate(-50%, -50%);
            transition: transform 0.1s ease-out;
        }

        /* --- Navigation --- */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 25px 10%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 100;
            background: linear-gradient(to bottom, rgba(10,10,10,0.8), rgba(10,10,10,0));
            backdrop-filter: blur(5px);
        }

        .logo {
            font-family: var(--font-display);
            font-size: 1.2rem;
            letter-spacing: 2px;
            color: var(--text-main);
            text-decoration: none;
        }

        .logo span {
            color: var(--primary-red);
        }

        .nav-links a {
            color: var(--text-muted);
            text-decoration: none;
            margin-left: 30px;
            font-weight: 600;
            font-size: 0.9rem;
            transition: color 0.3s;
        }

        .nav-links a:hover {
            color: var(--primary-red);
        }

        /* --- Hero Section --- */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding: 0 10%;
            position: relative;
        }

        .hero-container {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 50px;
            align-items: center;
            width: 100%;
            margin-top: 60px;
        }

        .hero-text h1 {
            font-family: var(--font-display);
            font-size: 3.5rem;
            line-height: 1.1;
            margin-bottom: 20px;
            text-transform: uppercase;
        }

        .hero-text h1 span {
            color: transparent;
            -webkit-text-stroke: 1px var(--primary-red);
        }

        .hero-text p {
            font-size: 1.1rem;
            color: var(--text-muted);
            margin-bottom: 40px;
            max-width: 500px;
            line-height: 1.6;
        }

        /* Hero Image Container with Optical Flow/Parallax Vibe */
        .hero-img-wrapper {
            position: relative;
            width: 100%;
            max-width: 400px;
            justify-self: center;
        }

        .hero-img-card {
            width: 100%;
            height: 530px;
            border-radius: 12px;
            overflow: hidden;
            position: relative;
            border: 1px solid rgba(255, 30, 39, 0.2);
            box-shadow: 0 20px 40px rgba(0,0,0,0.5);
            transition: transform 0.3s ease;
        }

        .hero-img-card:hover {
            transform: scale(1.02);
            border-color: var(--primary-red);
        }

        .hero-img-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            filter: grayscale(20%) contrast(110%);
        }

        /* Decorative Background Red Glows */
        .glow-sphere {
            position: absolute;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(255,30,39,0.15) 0%, rgba(0,0,0,0) 70%);
            top: 20%;
            right: 10%;
            z-index: -1;
            pointer-events: none;
        }

        /* --- Social Buttons --- */
        .btn-container {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }

        .social-btn {
            padding: 12px 30px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
        }

        .btn-linkedin {
            background-color: var(--primary-red);
            color: var(--text-main);
            box-shadow: 0 4px 15px rgba(255, 30, 39, 0.3);
        }

        .btn-linkedin:hover {
            background-color: var(--accent-red);
            transform: translateY(-3px);
        }

        .btn-instagram {
            background-color: transparent;
            color: var(--text-main);
            border: 2px solid var(--text-main);
        }

        .btn-instagram:hover {
            background-color: var(--text-main);
            color: var(--bg-color);
            transform: translateY(-3px);
        }

        /* --- About/Experience Section --- */
        .about {
            padding: 100px 10%;
            background-color: #0f0f0f;
        }

        .section-title {
            font-family: var(--font-display);
            font-size: 2rem;
            margin-bottom: 50px;
            position: relative;
            display: inline-block;
        }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 0;
            width: 50px;
            height: 3px;
            background-color: var(--primary-red);
        }

        .grid-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
        }

        .card {
            background-color: var(--card-bg);
            padding: 40px;
            border-radius: 8px;
            border: 1px solid #1f1f1f;
            transition: all 0.3s ease;
        }

        .card:hover {
            border-color: var(--primary-red);
            transform: translateY(-5px);
        }

        .card h3 {
            font-size: 1.3rem;
            margin-bottom: 15px;
        }

        .card p {
            color: var(--text-muted);
            line-height: 1.6;
            font-size: 0.95rem;
        }

        /* --- Footer --- */
        footer {
            padding: 40px 10%;
            border-top: 1px solid #141414;
            text-align: center;
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        /* --- Optical Flow Scroll Animation Classes --- */
        .reveal {
            opacity: 0;
            transform: translateY(40px);
            transition: opacity 0.8s ease-out, transform 0.8s ease-out;
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        /* --- Responsive Tweaks --- */
        @media (max-width: 968px) {
            .hero-container {
                grid-template-columns: 1fr;
                text-align: center;
            }
            .hero-text h1 {
                font-size: 2.5rem;
            }
            .hero-text p {
                margin: 0 auto 40px auto;
            }
            .btn-container {
                justify-content: center;
            }
            .hero-img-wrapper {
                margin-top: 20px;
            }
            .nav-links {
                display: none; /* Kept clean for single page */
            }
        }
    </style>
</head>
<body>

    <div class="cursor-dot" id="custom-dot"></div>
    <div class="cursor-outline" id="custom-outline"></div>

    <div class="glow-sphere"></div>

    <nav>
        <a href="#" class="logo">SUMIT<span>.</span></a>
        <div class="nav-links">
            <a href="#">Home</a>
            <a href="#about">About</a>
            <a href="#connect">Connect</a>
        </div>
    </nav>

    <section class="hero">
        <div class="hero-container">
            <div class="hero-text reveal">
                <h1>Sumit <br><span>Sasalatti</span></h1>
                <p>Welcome to my digital space. Driven by creativity and connectivity, I construct sleek experiences where high aesthetics meet optimized code architecture.</p>
                
                <div class="btn-container">
                    <a href="https://www.linkedin.com/in/sumit-sasalatti-4b3ba0384?utm_source=share_via&utm_content=profile&utm_medium=member_android" target="_blank" class="social-btn btn-linkedin">
                        Connect on LinkedIn
                    </a>
                    <a href="https://www.instagram.com/sumit_sasalatti?utm_source=qr&igsh=MTRrd3B4eTRuaGZqMw==" target="_blank" class="social-btn btn-instagram">
                        Follow on Instagram
                    </a>
                </div>
            </div>

            <div class="hero-img-wrapper reveal" style="transition-delay: 0.2s;">
                <div class="hero-img-card">
                    <img src="41751.heic" alt="Sumit Sasalatti Profile Photo">
                </div>
            </div>
        </div>
    </section>

    <section class="about" id="about">
        <h2 class="section-title reveal">What I Do</h2>
        <div class="grid-container">
            <div class="card reveal">
                <h3>Digital Strategy</h3>
                <p>Leveraging networks across LinkedIn and Instagram to manage brands, create impactful online signatures, and optimize audience outreach.</p>
            </div>
            <div class="card reveal" style="transition-delay: 0.1s;">
                <h3>Creative Design</h3>
                <p>Building aesthetics that command attention. Using strong contrasts, bold typography systems, and immersive color pairings like strict Red & Black.</p>
            </div>
            <div class="card reveal" style="transition-delay: 0.2s;">
                <h3>Interactive Flow</h3>
                <p>Designing interfaces that respond naturally to user actions. Implementing intuitive cursor dynamics, fluid animations, and smooth visual states.</p>
            </div>
        </div>
    </section>

    <footer id="connect">
        <p>&copy; 2026 Sumit Sasalatti. Designed with precision.</p>
    </footer>

    <script>
        // --- 1. Dual-Element Custom Mouse Animation ---
        const dot = document.getElementById("custom-dot");
        const outline = document.getElementById("custom-outline");

        window.addEventListener("mousemove", function(e) {
            const posX = e.clientX;
            const posY = e.clientY;

            // Direct tracking for the core dot
            dot.style.left = `${posX}px`;
            dot.style.top = `${posY}px`;

            // Lagged/Fluid tracking for the outer ring (Optical Flow vibe)
            outline.animate({
                left: `${posX}px`,
                top: `${posY}px`
            }, { duration: 400, fill: "forwards" });
        });

        // Add magnetic scale expansions on hovering interactive elements
        const targets = document.querySelectorAll('a, .card');
        targets.forEach(item => {
            item.addEventListener('mouseenter', () => {
                dot.style.width = '24px';
                dot.style.height = '24px';
                dot.style.backgroundColor = 'rgba(255, 30, 39, 0.2)';
                outline.style.borderColor = '#ff1e27';
            });
            item.addEventListener('mouseleave', () => {
                dot.style.width = '8px';
                dot.style.height = '8px';
                dot.style.backgroundColor = '#ff1e27';
                outline.style.borderColor = 'rgba(255, 30, 39, 0.4)';
            });
        });

        // --- 2. Scroll-Linked Optical Flow Reveal Logic ---
        function revealOnScroll() {
            const reveals = document.querySelectorAll('.reveal');
            const windowHeight = window.innerHeight;
            
            reveals.forEach(element => {
                const elementTop = element.getBoundingClientRect().top;
                // Elements active when 120px above the bottom viewport frame
                if (elementTop < windowHeight - 120) {
                    element.classList.add('active');
                }
            });
        }

        window.addEventListener('scroll', revealOnScroll);
        // Run once on load to populate visible elements immediately
        window.addEventListener('load', revealOnScroll);
    </script>
</body>
</html>
